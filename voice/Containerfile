# Linux only (the mini PC). On macOS run voice.py natively — see README.
FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      libportaudio2 libsndfile1 alsa-utils espeak-ng curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY voice/requirements.txt /app/voice/requirements.txt
RUN pip install --no-cache-dir -r /app/voice/requirements.txt piper-tts

# Natural-sounding offline voice for Piper (downloaded at build time).
ARG PIPER_VOICE_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium
RUN mkdir -p /models/piper && \
    curl -fsSL -o /models/piper/en_US-lessac-medium.onnx      "$PIPER_VOICE_BASE/en_US-lessac-medium.onnx" && \
    curl -fsSL -o /models/piper/en_US-lessac-medium.onnx.json "$PIPER_VOICE_BASE/en_US-lessac-medium.onnx.json"

COPY voice/ /app/voice/
COPY config.example.yaml /app/config.example.yaml

# Whisper and wake-word models are cached here between restarts.
ENV HF_HOME=/cache/hf
VOLUME ["/cache"]
CMD ["python", "/app/voice/voice.py"]
